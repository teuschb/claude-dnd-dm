#!/usr/bin/env python3
"""MCP wrapper for dm20-protocol (dnd-dm plugin).

Resolves the project's D&D data dir, creates it if missing, seeds the SRD
rulebook cache into it, sets DM20_STORAGE_DIR, then execs dm20-protocol via uvx.
Nothing is printed to stdout (it is the MCP stdio channel).
"""
from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))
import dnd_paths  # noqa: E402

DM20_PIN = "7725cb32297303e58d153bbce60bfaa37f4ab34a"
DM20_SRC = f"git+https://github.com/teuschb/dm20-protocol@{DM20_PIN}"
MARKER = ".dnd-dm-seed-version"


def log(msg: str) -> None:
    print(f"dm20 wrapper: {msg}", file=sys.stderr)
    path = os.environ.get("DND_DM_DEBUG_LOG")
    if path:
        with open(path, "a", encoding="utf-8") as fh:
            fh.write(msg + "\n")


def seed_cache(data: Path) -> None:
    """Copy the plugin's SRD cache into the data dir when missing or the plugin changed.

    Copy, never symlink: dm20 may write there. Existing files dm20 added are kept.
    """
    src = dnd_paths.PLUGIN_ROOT / "rulebook_cache" / "srd_2024"
    if not src.is_dir():
        return
    cache = data / "rulebook_cache"
    dst = cache / "srd_2024"
    marker = cache / MARKER
    version = dnd_paths.plugin_version()
    if dst.is_dir() and marker.is_file() and marker.read_text(encoding="utf-8").strip() == version:
        return
    cache.mkdir(parents=True, exist_ok=True)
    shutil.copytree(src, dst, dirs_exist_ok=True)
    marker.write_text(version + "\n", encoding="utf-8")
    log(f"seeded SRD cache into {dst} (plugin {version})")


def ensure_gitignore(data: Path) -> None:
    """New data dir: write the safe default .gitignore (campaigns/events private until the owner chooses)."""
    target = data / ".gitignore"
    template = dnd_paths.PLUGIN_ROOT / "templates" / "data-dir.gitignore"
    if not target.exists() and template.is_file():
        shutil.copyfile(template, target)


def main() -> None:
    root = dnd_paths.project_root()
    data = dnd_paths.data_dir(root)
    existed = data.exists()
    data.mkdir(parents=True, exist_ok=True)
    if not existed:
        ensure_gitignore(data)
    try:
        seed_cache(data)
    except OSError as exc:  # a seeding problem must not stop the server
        log(f"cache seeding failed: {exc}")
    os.environ["DM20_STORAGE_DIR"] = str(data)
    log(f"project={root} cwd={os.getcwd()} CLAUDE_PROJECT_DIR={os.environ.get('CLAUDE_PROJECT_DIR')} data={data}")
    os.execvp("uvx", ["uvx", "--from", DM20_SRC, "dm20-protocol", *sys.argv[1:]])


if __name__ == "__main__":
    main()
